within Roll2RollDynamics.Examples;
package WebLines
  "Roll-to-roll lines and transport benchmarks assembled from library components"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info = "<html>
<p>Complete lines and transport benchmarks:</p>
<ul>
<li><a href=\"modelica://Roll2RollDynamics.Examples.WebLines.MisalignedIdlerLine\">MisalignedIdlerLine</a>:
a film line with tension control, a translating dancer and fixed-yaw tracking.</li>
<li><a href=\"modelica://Roll2RollDynamics.Examples.WebLines.KimTwoActuatorLine\">KimTwoActuatorLine</a>:
a two-actuator winding line compared with Kim's published measurements and
radius estimator.</li>
</ul>
</html>"));
end WebLines;
