setCommandLineOptions("--std=3.6");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
mkdir("build/webwrap-checks");
cd("build/webwrap-checks");
simulate(Roll2RollDynamicsTest.WebWrapChecks.SpatialResultant, fileNamePrefix="WebWrapChecks.SpatialResultant", stopTime=0.01, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.WebWrapChecks.CoarseReverseWrap, fileNamePrefix="WebWrapChecks.CoarseReverseWrap", stopTime=0.01, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.WebWrapChecks.MovingTangency, fileNamePrefix="WebWrapChecks.MovingTangency", stopTime=2, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.WebWrapChecks.ZeroResultant, fileNamePrefix="WebWrapChecks.ZeroResultant", stopTime=0.01, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.WebWrapChecks.SpanGradient, fileNamePrefix="WebWrapChecks.SpanGradient", stopTime=0.01, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.WebWrapChecks.InvalidDirection, fileNamePrefix="WebWrapChecks.InvalidDirection", stopTime=0.01, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.WebWrapChecks.InvalidRadius, fileNamePrefix="WebWrapChecks.InvalidRadius", stopTime=0.01, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.WebWrapChecks.ZeroTension, fileNamePrefix="WebWrapChecks.ZeroTension", stopTime=0.01, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.WebWrapChecks.AxialOnlyForce, fileNamePrefix="WebWrapChecks.AxialOnlyForce", stopTime=0.01, tolerance=1e-9);
getErrorString();
