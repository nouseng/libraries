setCommandLineOptions("--std=3.6 -d=aliasConflicts");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
mkdir("build/mass-conservation-checks");
cd("build/mass-conservation-checks");
simulate(Roll2RollDynamicsTest.MassConservationChecks.ContactSupportLoad, fileNamePrefix="MassConservationChecks.ContactSupportLoad", stopTime=1, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.SpanDirectionDerivativeCheck, fileNamePrefix="SpanDirectionDerivativeCheck", stopTime=2, tolerance=1e-9);
getErrorString();
// ObliqueStretch also exercises the inherited HeldSpan assertions.
simulate(Roll2RollDynamicsTest.MassConservationChecks.ObliqueStretch, fileNamePrefix="MassConservationChecks.ObliqueStretch", stopTime=20, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.WinderDirections, fileNamePrefix="MassConservationChecks.WinderDirections", stopTime=5, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.WinderMigration, fileNamePrefix="MassConservationChecks.WinderMigration", stopTime=5, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.ReverseLoop, fileNamePrefix="MassConservationChecks.ReverseLoop", stopTime=5, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.MovingWrap, fileNamePrefix="MassConservationChecks.MovingWrap", stopTime=10, tolerance=1e-9);
getErrorString();
// Delayed startup includes standstill and forward transport in one run.
simulate(Roll2RollDynamicsTest.MassConservationChecks.PausedWinding, fileNamePrefix="MassConservationChecks.PausedWinding", stopTime=10, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.HeldWinding, fileNamePrefix="MassConservationChecks.HeldWinding", stopTime=1, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.ReverseWinding, fileNamePrefix="MassConservationChecks.ReverseWinding", stopTime=10, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.TranslatingIdler, fileNamePrefix="MassConservationChecks.TranslatingIdler", stopTime=10, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.ConservativeNip, fileNamePrefix="MassConservationChecks.ConservativeNip", stopTime=8, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.ConservativeSteering, fileNamePrefix="MassConservationChecks.ConservativeSteering", stopTime=8, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.WrapBearingLoad, fileNamePrefix="MassConservationChecks.WrapBearingLoad", stopTime=0.1, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.StaticSpanWeight, fileNamePrefix="MassConservationChecks.StaticSpanWeight", stopTime=0.1, tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.MassConservationChecks.FrictionlessTorqueRoute, fileNamePrefix="MassConservationChecks.FrictionlessTorqueRoute", stopTime=0.1, tolerance=1e-9);
getErrorString();
