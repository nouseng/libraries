setCommandLineOptions("--std=3.6");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");

getComponents(Roll2RollDynamics.Components.Belt);
getComponents(Roll2RollDynamics.Components.Roller);
getComponents(Roll2RollDynamics.Components.Winder);
getComponents(Roll2RollDynamics.Utilities.Parts.WebWrap);
getComponents(Roll2RollDynamics.Utilities.Parts.RollBody);
getComponents(Roll2RollDynamics.Utilities.Parts.WebFriction);
getComponents(Roll2RollDynamics.Components.NipRoller);
getComponents(Roll2RollDynamics.Utilities.Parts.NipContact);
getConnectionCount(Roll2RollDynamics.Examples.WebLines.MisalignedIdlerLine);
getParameterValue(Roll2RollDynamics.Components.Roller, "fixedInitialAngle");
getParameterValue(Roll2RollDynamics.Components.Roller, "fixedInitialSpeed");
getParameterValue(Roll2RollDynamics.Components.Roller, "useNip");
checkModel(Roll2RollDynamicsTest.ComponentChecks.ExternalDancerSupportCheck);
checkModel(Roll2RollDynamics.Examples.WebLines.MisalignedIdlerLine);
getComponents(Roll2RollDynamics.Utilities.Interfaces.RollPort);
getComponents(Roll2RollDynamics.Utilities.Interfaces.SpanPort);
getNamedAnnotation(Roll2RollDynamics, version);
getErrorString();
