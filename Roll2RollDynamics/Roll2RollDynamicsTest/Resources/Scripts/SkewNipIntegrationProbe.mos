setCommandLineOptions("--std=3.6");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
simulate(Roll2RollDynamicsTest.SkewNipChecks.SkewNipIntegrationCheck, stopTime = 8,
  numberOfIntervals = 4000, tolerance = 1e-8, fileNamePrefix = "SkewNipLoading");
getErrorString();
simulate(Roll2RollDynamicsTest.SkewNipChecks.NipRunoutCheck, stopTime = 8,
  numberOfIntervals = 4000, tolerance = 1e-8, fileNamePrefix = "NipRunout");
getErrorString();
val(nip.nipContact.relativeMisalignment, 3, "SkewNipLoading_res.mat");
max({val(nip.nipVariables.nipLoad, 2.5 + i*0.005, "SkewNipLoading_res.mat") for i in 0:400});
min({val(nip.nipVariables.nipLoad, 2.5 + i*0.005, "SkewNipLoading_res.mat") for i in 0:400});
max({val(nip.nipVariables.nipLoad, 2.5 + i*0.005, "NipRunout_res.mat") for i in 0:400});
min({val(nip.nipVariables.nipLoad, 2.5 + i*0.005, "NipRunout_res.mat") for i in 0:400});
getErrorString();
