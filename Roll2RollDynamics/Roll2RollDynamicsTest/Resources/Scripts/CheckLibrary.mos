// Fast structural smoke check. Run the relevant specialized suite after
// physics changes; see Roll2RollDynamicsTest/README.md. This script builds no executables.
setCommandLineOptions("--std=3.6");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");

// Public components and independently usable parts.
checkModel(Roll2RollDynamics.WebWorld);
checkModel(Roll2RollDynamicsTest.ComponentChecks.BeltComponentCheck);
checkModel(Roll2RollDynamicsTest.ComponentChecks.RollerComponentCheck);
checkModel(Roll2RollDynamicsTest.ComponentChecks.WinderComponentCheck);
checkModel(Roll2RollDynamicsTest.ComponentChecks.RollerNipComponentCheck);
checkModel(Roll2RollDynamicsTest.ComponentChecks.FixedNipRollerComponentCheck);
checkModel(Roll2RollDynamicsTest.ComponentChecks.RollBodyComponentCheck);
checkModel(Roll2RollDynamicsTest.ComponentChecks.WebWrapComponentCheck);
checkModel(Roll2RollDynamicsTest.NipContactChecks.NipContactComponentCheck);
checkModel(Roll2RollDynamicsTest.ComponentChecks.WebForceComponentCheck);
checkModel(Roll2RollDynamics.Utilities.Parts.VariableGearR2T);
checkModel(Roll2RollDynamics.Utilities.Parts.DrumRunout);
checkModel(Roll2RollDynamics.Utilities.Parts.VariableTranslation);

// Every remaining public example and the assembled line.
checkModel(Roll2RollDynamics.Examples.OpenBeltDrive);
checkModel(Roll2RollDynamics.Examples.ThreeRollWebLoop);
checkModel(Roll2RollDynamics.Examples.NipLoading);
checkModel(Roll2RollDynamics.Examples.SlipAndTractionCapacity);
checkModel(Roll2RollDynamicsTest.TangencyQuadrants);
checkModel(Roll2RollDynamics.Examples.SheltonSteering);
checkModel(Roll2RollDynamics.Examples.RetractingIdler);
checkModel(Roll2RollDynamics.Examples.WebLines.MisalignedIdlerLine);
checkModel(Roll2RollDynamics.Examples.WebLines.KimTwoActuatorLine);
getErrorString();
