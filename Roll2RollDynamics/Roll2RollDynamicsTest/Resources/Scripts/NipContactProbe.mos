setCommandLineOptions("--std=3.6");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
simulate(Roll2RollDynamicsTest.NipContactChecks.DisabledNipContactCheck, fileNamePrefix="DisabledNipContactCheck", startTime = 0, stopTime = 0.01,
  numberOfIntervals = 1, tolerance = 1e-8, method = "dassl");
getErrorString();
simulate(Roll2RollDynamicsTest.NipContactChecks.NipContactBehaviorCheck, fileNamePrefix="NipContactBehaviorCheck", startTime = 0, stopTime = 0.01,
  numberOfIntervals = 1, tolerance = 1e-8, method = "dassl");
val(separated.normalForce, 0.01);
val(shallow.normalForce, 0.01);
val(deep.normalForce, 0.01);
val(forward.slipVelocity, 0.01);
val(forward.tangentialForce, 0.01);
val(reverse.slipVelocity, 0.01);
val(reverse.tangentialForce, 0.01);
val(forward.frictionLoss, 0.01);
val(reverse.frictionLoss, 0.01);
getErrorString();
