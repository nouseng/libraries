setCommandLineOptions("--std=3.6 -d=aliasConflicts");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
getErrorString();
mkdir("build/tram-checks");
cd("build/tram-checks");
simulate(Roll2RollDynamicsTest.TramChecks.TrammedNip, fileNamePrefix="TramChecks.TrammedNip", stopTime=8, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.TramChecks.CrossedNip, fileNamePrefix="TramChecks.CrossedNip", stopTime=8, tolerance=1e-8);
getErrorString();
simulate(Roll2RollDynamicsTest.TramChecks.TrammedIdler, fileNamePrefix="TramChecks.TrammedIdler", stopTime=20, tolerance=1e-7);
getErrorString();
