setCommandLineOptions("--std=3.6 -d=aliasConflicts");
loadModel(Modelica,{"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
getErrorString();
mkdir("build/local-belt-checks");
cd("build/local-belt-checks");
simulate(Roll2RollDynamicsTest.LocalBeltDynamicsChecks.ForceDriven, fileNamePrefix="LocalBeltDynamicsChecks.ForceDriven",stopTime=0.5,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.LocalBeltDynamicsChecks.InclinedGravity, fileNamePrefix="LocalBeltDynamicsChecks.InclinedGravity",stopTime=0.2,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.LocalBeltDynamicsChecks.TranslatingSupports, fileNamePrefix="LocalBeltDynamicsChecks.TranslatingSupports",stopTime=0.5,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.LocalBeltDynamicsChecks.RotatingSpan, fileNamePrefix="LocalBeltDynamicsChecks.RotatingSpan",stopTime=0.5,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.LocalBeltDynamicsChecks.ChangingInventory, fileNamePrefix="LocalBeltDynamicsChecks.ChangingInventory",stopTime=0.5,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.LocalBeltDynamicsChecks.ReverseTransport, fileNamePrefix="LocalBeltDynamicsChecks.ReverseTransport",stopTime=0.5,tolerance=1e-9);
getErrorString();
