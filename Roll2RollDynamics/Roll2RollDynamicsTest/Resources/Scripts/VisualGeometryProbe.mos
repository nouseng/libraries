setCommandLineOptions("--std=3.6");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
simulate(Roll2RollDynamicsTest.VisualGeometryChecks.BeltVisualGeometryCheck, fileNamePrefix="BeltVisualGeometryCheck", stopTime = 0.01, tolerance = 1e-8);
simulate(Roll2RollDynamicsTest.VisualGeometryChecks.WinderVisualGeometryCheck, fileNamePrefix="WinderVisualGeometryCheck", stopTime = 0.01, tolerance = 1e-8);
simulate(Roll2RollDynamicsTest.VisualGeometryChecks.RollerWrapVisualGeometryCheck, fileNamePrefix="RollerWrapVisualGeometryCheck", stopTime = 0.01, tolerance = 1e-8);
simulate(Roll2RollDynamicsTest.VisualGeometryChecks.RollerFacadeCompositionCheck, fileNamePrefix="RollerFacadeCompositionCheck", stopTime = 0.05, tolerance = 1e-8);
simulate(Roll2RollDynamicsTest.VisualGeometryChecks.SpanColorGradingCheck, fileNamePrefix="SpanColorGradingCheck", stopTime = 0.01, tolerance = 1e-8);
simulate(Roll2RollDynamicsTest.VisualGeometryChecks.WrapColorGradingCheck, fileNamePrefix="WrapColorGradingCheck", stopTime = 0.01, tolerance = 1e-8);
simulate(Roll2RollDynamicsTest.VisualGeometryChecks.WebWorldStressBarCheck, fileNamePrefix="WebWorldStressBarCheck", stopTime = 0.01, tolerance = 1e-8);
simulate(Roll2RollDynamicsTest.VisualGeometryChecks.DegenerateSpanWidthCheck, fileNamePrefix="DegenerateSpanWidthCheck", stopTime = 0.01, tolerance = 1e-8);
getErrorString();
