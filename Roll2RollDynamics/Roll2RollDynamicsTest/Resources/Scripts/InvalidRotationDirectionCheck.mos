setCommandLineOptions("--std=3.6");
loadModel(Modelica, {"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
simulate(Roll2RollDynamicsTest.InvalidRotationDirectionCheck.InvalidRotationDirectionCheck, fileNamePrefix="InvalidRotationDirectionCheck", startTime = 0, stopTime = 0.01,
  numberOfIntervals = 1, tolerance = 1e-6);
getErrorString();
simulate(Roll2RollDynamicsTest.InvalidRotationDirectionCheck.InvalidWinderDirectionCheck, fileNamePrefix="InvalidWinderDirectionCheck", startTime = 0, stopTime = 0.01,
  numberOfIntervals = 1, tolerance = 1e-6);
getErrorString();
