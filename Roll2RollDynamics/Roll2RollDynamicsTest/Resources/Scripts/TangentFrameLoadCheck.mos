setCommandLineOptions("--std=3.6 -d=aliasConflicts");
loadModel(Modelica,{"4.1.0"});
loadFile("Roll2RollDynamics/package.mo");
loadFile("Roll2RollDynamicsTest/package.mo");
getErrorString();
mkdir("build/tangent-frame-load-check");
cd("build/tangent-frame-load-check");
simulate(Roll2RollDynamicsTest.TangentFrameLoadCheck.SkewTransverse, fileNamePrefix="TangentFrameLoadCheck.SkewTransverse",stopTime=0.01,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.TangentFrameLoadCheck.LongitudinalOnly, fileNamePrefix="TangentFrameLoadCheck.LongitudinalOnly",stopTime=0.01,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.TangentFrameLoadCheck.MixedForceAndMoment, fileNamePrefix="TangentFrameLoadCheck.MixedForceAndMoment",stopTime=0.01,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.TangentFrameLoadCheck.FullMoment, fileNamePrefix="TangentFrameLoadCheck.FullMoment",stopTime=0.01,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.TangentFrameLoadCheck.ReverseDirection, fileNamePrefix="TangentFrameLoadCheck.ReverseDirection",stopTime=0.01,tolerance=1e-9);
getErrorString();
simulate(Roll2RollDynamicsTest.TangentFrameLoadCheck.MovingSkew, fileNamePrefix="TangentFrameLoadCheck.MovingSkew",stopTime=4,tolerance=1e-9);
getErrorString();
